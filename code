# Menu-Driven Student Information System
students = {}

def add_student():
    """Prompts the user for student details and saves them."""
    roll = input("Enter Roll No: ")
    name = input("Enter Name: ")
    dept = input("Enter Department: ")
    
    # Stores the name and department in a nested dictionary linked to the Roll No
    students[roll] = {"Name": name, "Department": dept}
    print("Student added successfully.")

def view_students():
    """Iterates through the dictionary to display all saved students."""
    if not students:
        print("No student records found.")
        return
        
    print("\n--- Student Records ---")
    for roll, data in students.items():
        print(f"Roll No: {roll} | Name: {data['Name']} | Department: {data['Department']}")

def search_student():
    """Looks up a student using their Roll No as the dictionary key."""
    roll = input("Enter Roll No to search: ")
    if roll in students:
        print(f"Found - Name: {students[roll]['Name']}, Department: {students[roll]['Department']}")
    else:
        print("Student not found.")

def delete_student():
    """Removes a student from the dictionary if the Roll No exists."""
    roll = input("Enter Roll No to delete: ")
    if roll in students:
        del students[roll]
        print("Student deleted successfully.")
    else:
        print("Student not found.")

# Main program loop
while True:
    print("\n--- Main Menu ---")
    print("1. Add Student")
    print("2. View Students")
    print("3. Search Student")
    print("4. Delete Student")
    print("5. Exit")
    
    choice = input("Enter your choice: ")
    
    if choice == "1":
        add_student()
    elif choice == "2":
        view_students()
    elif choice == "3":
        search_student()
    elif choice == "4":
        delete_student()
    elif choice == "5":
        print("Exiting...")
        break
    else:
        print("Invalid choice. Please enter a number between 1 and 5.")
